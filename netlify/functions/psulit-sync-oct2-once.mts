const slug=v=>String(v).toUpperCase().replace(/[^A-Z0-9]+/g,"-").replace(/^-|-$/g,"");
function rows(x){
 const c={submittedAt:x.t,businessDate:x.d,branch:"Solaire",countType:x.ct,shift:x.s,teller:x.tel,reference:x.r,sourceApp:"Cash Count App"};
 const a=[]; const add=(k,f)=>a.push({syncKey:x.r+":"+k,...c,...f});
 for(const[k,v]of Object.entries(x.fx)) add("FOREX-"+slug(k),{category:"Forex Cash",currency:k,fundAccount:"Forex Drawer",amount:v,phpEquivalent:k==="PHP"?v:"",quantityUnits:"",notes:"Historical image backfill"});
 if(x.h!=null) add("FUND-HIVE",{category:"Fund Balance",currency:"PHP",fundAccount:"Hive",amount:x.h,phpEquivalent:x.h,quantityUnits:"",notes:"Historical image backfill"});
 if(x.bank) for(const[k,v]of Object.entries(x.bank)) add("BANK-"+slug(k),{category:"Bank Balance",currency:k,fundAccount:"BDO",amount:v,phpEquivalent:k==="PHP"?v:"",quantityUnits:"",notes:"Historical image backfill"});
 for(const[z,i]of (x.rec||[]).entries()) add("RECEIVABLE-"+slug(i[0])+"-"+z,{category:"Receivable",currency:i[1],fundAccount:i[0],amount:i[2],phpEquivalent:i[1]==="PHP"?i[2]:"",quantityUnits:"",notes:"Historical image backfill"});
 add("SUMMARY-FOREX-TOTAL",{category:"Summary",currency:"PHP",fundAccount:"Forex PHP Equivalent",amount:x.ft,phpEquivalent:x.ft,quantityUnits:"",notes:"Displayed report total; historical image backfill"});
 if(x.gt!=null) add("SUMMARY-GRAND-TOTAL",{category:"Summary",currency:"PHP",fundAccount:"Grand Total",amount:x.gt,phpEquivalent:x.gt,quantityUnits:"",notes:"Displayed report total; historical image backfill"});
 return a;
}
export default async()=>{
