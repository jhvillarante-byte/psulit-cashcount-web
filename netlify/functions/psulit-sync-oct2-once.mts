   out.push({ref:"SORT-"+branch,status:q.status,result:j,rows:0});
 }
 return new Response(JSON.stringify({ok:out.every(x=>x.status>=200&&x.status<300),count:DATA.length,results:out}),{headers:{"content-type":"application/json"}});
